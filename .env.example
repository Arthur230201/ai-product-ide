# AI Product IDE - 环境变量示例
# 复制本文件为 .env.local 并填写实际值，不要提交 .env.local 到版本库。

# OpenAI API Key（必填，用于 PRD/UI 生成、拓扑解析等）
OPENAI_API_KEY=

# 可选：OpenAI 兼容代理（对接 reelxai.com / llmxapi.com 时必填）
# 原地址 https://api.openai.com/v1 替换为下方其一，key 用本站的 sk-xxx
# OPENAI_BASE_URL=https://reelxai.com/v1
# OPENAI_BASE_URL=https://llmxapi.com/v1
# 备用 OPENAI_BASE_URL=https://hk.reelxai.com/v1

# 可选：指定模型（默认已使用 gpt-5.2；UI 生成固定走 quality 档位）
# NEXT_PUBLIC_AI_TEXT_MODEL=gpt-5.2
# NEXT_PUBLIC_AI_VISION_MODEL=gpt-5.2
# 其他：gpt-5.2-2025-12-11, gpt-4o, gemini-2.5-pro

# 可选：风格选「智能推荐」时，设为 0 则跳过「推荐设计系统」额外 LLM（仍不锁固定预设）
# AI_DESIGN_SYSTEM_RECOMMEND=0
# 可选：注入 system 前推荐块最大字节数（默认 8192）
# DESIGN_SYSTEM_MARKDOWN_MAX_BYTES=8192
