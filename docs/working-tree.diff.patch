-      });
-      clearTimeout(timeoutId);
-      return response;
-    } catch (error) {
-      clearTimeout(timeoutId);
-      throw error;
+    if (hasInteractionKeywords) {
+      interactionClosure = 50;
     }
-  },
-});
+
+    // Data support
+    const hasDataKeywords = 
+      promptLower.includes('数据') || 
+      promptLower.includes('列表') || 
+      promptLower.includes('内容') ||
+      promptLower.includes('示例');
+    
+    if (hasDataKeywords) {
+      dataSupport = 50;
+    }
+  }
+
+  // Determine mode based on scores
+  const avgScore = (completeness + coherence + interactionClosure + dataSupport) / 4;
+  let mode: UIRationalityMode;
+  let reasoning: string;
+
+  if (avgScore >= 75 && completeness >= 70 && coherence >= 70) {
+    mode = 'PRESERVE';
+    reasoning = `输入UI完整性高（${completeness}%），逻辑一致性好（${coherence}%）。采用PRESERVE模式：保留现有UI结构，仅做细微优化。`;
+  } else if (avgScore >= 50 && (completeness < 70 || interactionClosure < 50 || dataSupport < 50)) {
+    mode = 'COMPLETE';
+    reasoning = `输入UI部分完整（${completeness}%），但交互闭合性（${interactionClosure}%）或数据支持（${dataSupport}%）不足。采用COMPLETE模式：补充缺失的交互逻辑和数据支持。`;
+  } else {
+    mode = 'RATIONALIZE';
+    reasoning = `输入UI需要全面合理化（平均分${avgScore.toFixed(1)}%）。采用RATIONALIZE模式：重构UI结构，确保所有交互有真实行为，所有功能有数据支持。`;
+  }
+
+  const assessment: UIRationalityAssessment = {
+    scores: { completeness, coherence, interactionClosure, dataSupport },
+    mode,
+    reasoning,
+  };
+
+  log('📊 [UI Rationality Scoring] 评估结果:', {
+    scores: assessment.scores,
+    mode: assessment.mode,
+    reasoning: assessment.reasoning,
+  });
+
+  return assessment;
+}
