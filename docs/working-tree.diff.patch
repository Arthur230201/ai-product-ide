+/**
+ * Evaluates UI rationality from text/HTML input
+ * Analyzes the text/HTML to assess completeness, coherence, interaction closure, and data support
+ */
+function assessUIRationalityFromText(
+  prompt: string,
+  htmlContent?: string,
+  existingCode?: string
+): UIRationalityAssessment {
+  log('🔍 [UI Rationality Scoring] 开始评估文本/HTML输入...');
+  
+  // Initialize scores
+  let completeness = 40;        // Default: text descriptions are usually incomplete
+  let coherence = 60;            // Default: text may have some structure
+  let interactionClosure = 20;   // Default: text descriptions rarely specify interactions
+  let dataSupport = 30;         // Default: text descriptions rarely include data
+
+  // Analyze prompt
+  const promptLower = prompt.toLowerCase();
+  const hasExplicitRequest = promptLower.includes('复刻') || promptLower.includes('还原') || promptLower.includes('clone');
+  const hasImprovementRequest = promptLower.includes('改进') || promptLower.includes('优化') || promptLower.includes('完善');
+  const hasCompleteRequest = promptLower.includes('完整') || promptLower.includes('complete') || promptLower.includes('全部');
+
+  // Analyze HTML content if provided
+  if (htmlContent) {
+    const htmlLength = htmlContent.length;
+    const hasButtons = /<button|<a\s+[^>]*class/i.test(htmlContent);
+    const hasInputs = /<input|<textarea/i.test(htmlContent);
+    const hasLists = /<ul|<ol|<li/i.test(htmlContent);
+    const hasData = /<div[^>]*>[\s\S]{50,}/i.test(htmlContent); // Has substantial content
+
+    // Completeness: HTML provides structure
+    if (htmlLength > 5000) {
+      completeness = 85; // Large HTML likely complete
+    } else if (htmlLength > 1000) {
+      completeness = 70; // Medium HTML
+    } else {
+      completeness = 50; // Small HTML
+    }
+
+    // Coherence: HTML structure indicates logical organization
+    if (hasButtons && hasInputs && hasLists) {
+      coherence = 80; // Well-structured HTML
+    } else if (hasButtons || hasInputs) {
+      coherence = 65; // Some structure
+    }
+
+    // Interaction closure: HTML with buttons/inputs suggests interactions
+    if (hasButtons && hasInputs) {
+      interactionClosure = 60; // HTML has interactive elements
+    } else if (hasButtons || hasInputs) {
+      interactionClosure = 45; // Some interactive elements
+    }
+
+    // Data support: HTML with lists and content suggests data
+    if (hasLists && hasData) {
+      dataSupport = 70; // HTML has data structure
+    } else if (hasLists || hasData) {
+      dataSupport = 50; // Some data structure
+    }
+  } else {
+    // Text-only analysis
+    // Completeness
+    if (hasCompleteRequest || existingCode) {
+      completeness = 70;
+    } else if (hasExplicitRequest) {
+      completeness = 60;
+    } else if (prompt.length > 200) {
+      completeness = 50; // Long description suggests more complete
+    }
+
+    // Coherence
+    if (prompt.length > 100 && !promptLower.includes('?')) {
+      coherence = 70;
+    } else if (prompt.length > 50) {
+      coherence = 60;
+    }
+
+    // Interaction closure
+    const hasInteractionKeywords = 
+      promptLower.includes('交互') || 
+      promptLower.includes('点击') || 
+      promptLower.includes('筛选') || 
+      promptLower.includes('标签') ||
+      promptLower.includes('按钮');
     
